HTTP_PORT=8080
ADMIN_USER=admin
# Starkes Passwort setzen (mind. 8 Zeichen, nicht „admin“) – sonst ist die Anmeldung nur aus privaten Netzen möglich.
ADMIN_PASSWORD=admin
# PFLICHT: zufälliger Schlüssel ≥ 32 Zeichen, z. B. `openssl rand -hex 32` – mit dem Standardwert startet das Backend nicht.
SECRET_KEY=change-me-please
POSTGRES_PASSWORD=vg
DEMO_CAMERAS=1
# SECRET_KEY signiert Sitzungen, API-Keys (Hash) und Medien-Links – Ändern macht alle ungültig.
# MEDIA_PUBLIC=1 → /media ohne Anmeldung (altes Verhalten, nicht empfohlen)
MEDIA_PUBLIC=0
COMPOSE_PROFILES=demo
TZ=Europe/Berlin
# MCP_ALLOWED_HOSTS=vg.example.org,localhost
